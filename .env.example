# Database Connection (Supabase PostgreSQL)
# Option 1 (Recommended for Vercel): Use Supabase Session/Transaction Pooler URI (IPv4 compatible)
# Get this from Supabase Dashboard -> Connect -> Session pooler
# DATABASE_URL=postgresql://postgres.qcarrbjkduwtovaukmrv:YOUR_SUPABASE_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Option 2 (Local dev with IPv6): Individual PostgreSQL variables
PGHOST=db.qcarrbjkduwtovaukmrv.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=YOUR_SUPABASE_DB_PASSWORD
PGSSLMODE=require

# Production Security & SEO
JWT_SECRET=virasat-heritage-secret-change-in-production
NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app

